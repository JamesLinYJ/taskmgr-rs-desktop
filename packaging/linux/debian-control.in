Package: taskmgr-rs
Version: @VERSION@
Section: utils
Priority: optional
Architecture: @ARCHITECTURE@
Maintainer: JamesLinYJ
Depends: libgtk-3-0 | libgtk-3-0t64, libayatana-appindicator3-1 | libappindicator3-1, libblkid1, liblzma5, policykit-1
